# Copy this file to .env and set your own password.
# Used by Docker Compose (POSTGRES_*), the app (DATABASE_URL) and the tests (TEST_DATABASE_URL).
POSTGRES_USER=career_copilot
POSTGRES_PASSWORD=change-me
POSTGRES_DB=career_copilot
DATABASE_URL=postgresql+psycopg://career_copilot:change-me@127.0.0.1:5432/career_copilot
TEST_DATABASE_URL=postgresql+psycopg://career_copilot:change-me@127.0.0.1:5432/career_copilot_test
